# Backend API (server PORT=6933). Har platforma uchun host farq qiladi:
#   iOS simulator:      http://localhost:6933/api
#   Android emulator:   http://10.0.2.2:6933/api
#   Fizik qurilma:      http://<mashina-LAN-IP>:6933/api  (bir Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:6933/api

# Google OAuth (Google Cloud Console — 3 ta client kerak)
# Web client ID: server GOOGLE_CLIENT_ID bilan bir xil bo'lishi shart (audience)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS client ID'ning teskarisi (com.googleusercontent.apps.XXXX) — plugin/dev build uchun
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
